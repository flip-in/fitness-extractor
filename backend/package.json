{
  "name": "fitness-extractor-backend",
  "version": "1.0.0",
  "description": "Backend API server for Fitness Extractor - receives HealthKit data and serves dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "echo \"Tests to be implemented\" && exit 0"
  },
  "keywords": [
    "fitness",
    "healthkit",
    "api",
    "express",
    "postgresql"
  ],
  "author": "William Price",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.23.1",
    "@types/vt-pbf": "^3.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
