<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.williamprice.HealthKit-Sync.route-backfill</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<!-- The backend is plain HTTP on a Tailscale (100.x) address, which ATS does
	     not treat as local. Tailscale encrypts the transport; TLS is out of scope. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
